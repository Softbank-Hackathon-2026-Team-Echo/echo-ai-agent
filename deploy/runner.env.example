# /etc/echo-precheck-runner/runner.env — 비밀 없음(토큰·키는 시작 스크립트가 Secret Manager 에서 읽는다).
# 바꾼 뒤에는 `sudo systemctl restart echo-precheck-runner`.
ECHO_WAS_URL=https://api.echoport.uk
ECHO_RUNNER_NAME=echo-sandbox-runner
ECHO_GCP_PROJECT=team-echo-final
ECHO_APPLY_PATCH=off
# on = 점검 실행마다 모델 1회(과금) · off = 규칙 비교만(--no-model, model=null)
ECHO_PRECHECK_MODEL=on
# on = 시연 서비스(이미지 digest·서비스 이름)의 C-IMG-1 이 PASS 가 아니면 규칙 패치 1개(origin RULE)를 결과에 싣는다(--patch) · off = 싣지 않음(--no-patch). WAS 가 패치 origin 칸을 받는 뒤(echo-was #79)에만 on
ECHO_PRECHECK_PATCH=off
# WAS CHANGE_PROPOSAL/diagnosis 계약과 시연 파일 후단 연결을 확인한 뒤에만 on.
# PRECHECK 증거로 대체하지 않으며 모델 검토 on일 때만 사용한다.
ECHO_DIAGNOSIS=off
